# ============================================================
# 環境変数サンプル (.env にコピーして値を設定)
# ============================================================

# --- 実行環境 ---
NODE_ENV=production
PORT=3000

# --- データベース (MySQL / 必須) ---
# 例: mysql://user:password@host:3306/reskilling_lms
DATABASE_URL=
# 無料/マネージドMySQL(TiDB Cloud・Aiven・Clever等)はTLS必須。
# require で接続にTLSを付与する。ローカル(TLSなし)は未設定のままでよい。
# DATABASE_SSL=require

# --- 認証 (Manus OAuth) ---
# OAuth サーバーURL・JWT署名鍵・アプリID。プラットフォームから発行された値を設定
OAUTH_SERVER_URL=
JWT_SECRET=
VITE_APP_ID=
# 運営管理者の openId (任意。初期の全体管理者を固定したい場合)
OWNER_OPEN_ID=

# --- 内蔵AI (任意 / 利用する場合) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- 通知: メール (Amazon SES / 受講者への主軸チャネル) ---
# SESで検証済みの送信元アドレスとリージョン、及びAWS認証情報を設定
AWS_REGION=
LMS_MAIL_FROM=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY はデプロイ先のシークレット管理で付与
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- 通知: LINE (任意 / 補助チャネル) ---
# LINE公式アカウントのチャネルアクセストークン等は管理画面の「連携」から登録
#  (integrations テーブルに保存。ここでは環境変数不要)

# --- 通知: 内部Webhook (任意 / 協業先・運営向け) ---
#  Slack/Google Chat の Webhook URL、Chatwork のトークン・ルームIDは
#  管理画面「内部通知連携」から登録 (internal_webhooks テーブルに保存)

# ============================================================
# ゲスト閲覧モード (顧客への内容確認用の公開デモ)
# ============================================================
# LMS_PREVIEW_MODE=1 で、ログイン不要で運営(閲覧)としてデモを閲覧できる。
# 起動時にデモが空ならサンプルデータを自動投入する。本番では無効化(削除)すること。
# LMS_PREVIEW_MODE=1

# ============================================================
# 開発用 (ローカルのみ。NODE_ENV=production では無効)
# ============================================================
# LMS_DEV_LOGIN=1 のとき OAuth/DB 無しで運営ユーザーとしてUI確認が可能
# LMS_DEV_LOGIN=1
# LMS_DEV_EMAIL=dev@example.com
# LMS_DEV_NAME=開発ユーザー
