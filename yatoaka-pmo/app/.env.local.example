# ---- バックエンド（GAS）----
# GAS Web App の URL を設定するとリモート（スプレッドシート）モードで動作します。
# 未設定の場合はローカル（localStorage）モードのまま動作します。
# 例: https://script.google.com/macros/s/XXXXXXXX/exec
NEXT_PUBLIC_GAS_URL=

# ---- 認証（NextAuth / Auth.js）----
# AUTH_ENABLED=true のときのみログインを要求します（未設定なら認証バイパス＝試作モード）。
AUTH_ENABLED=false

# `npx auth secret` などで生成したランダム文字列
AUTH_SECRET=

# Google Cloud Console の OAuth 2.0 クライアント（種類: ウェブアプリケーション）
# 承認済みリダイレクト URI: <アプリのURL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 本番URL（例: https://pmo.example.jp）。ローカルは未設定でも可。
AUTH_URL=

# 内部利用者のみ許可（要件 3.1/3.2）。どちらか一方でも可。両方空なら全 Google 許可（試作）。
#   カンマ区切りの許可メール（完全一致）
AUTH_ALLOWED_EMAILS=
#   カンマ区切りの許可ドメイン（例: yatoaka.example.jp）
AUTH_ALLOWED_DOMAIN=
